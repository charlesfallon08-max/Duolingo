# Configuration Supabase (comptes utilisateurs + sauvegarde en ligne).
# Copie ce fichier en `.env.local` et remplis les deux valeurs,
# trouvables dans Supabase → Project Settings → API.
# Sans ces valeurs, le site fonctionne en mode local (pas de comptes).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=colle-ici-la-cle-anon-publique
